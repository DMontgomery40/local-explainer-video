# OpenAI API key (for GPT-4 director and fallback TTS)
OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude director)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Anthropic custom skill id/version to attach the full Remotion skill
# to director.py's direct Claude API call.
# Example skill id shape: skill_01AbCdEfGhIjKlMnOpQrStUv
REMOTION_SKILL_ID=
REMOTION_SKILL_VERSION=latest
DIRECTOR_REFERENCE_IMAGE_FILE_IDS=file_...,file_...,file_...
DIRECTOR_ANTHROPIC_MAX_TOKENS=64000
DIRECTOR_ANTHROPIC_EFFORT=high
DIRECTOR_ANTHROPIC_THINKING_TYPE=adaptive
DIRECTOR_ANTHROPIC_SPEED=
DIRECTOR_ANTHROPIC_ENABLE_COMPACTION=true
DIRECTOR_ANTHROPIC_BATCH_MAX_TOKENS=300000

# Replicate API token (for image generation)
REPLICATE_API_TOKEN=r8_...
